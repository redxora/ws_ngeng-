        <Item>clipset@veh@van@ds@hit_wheel@idle_a</Item>
		<Item>clipset@veh@van@ds@hit_wheel@idle_b</Item>
		<Item>clipset@veh@van@ds@hit_wheel@idle_c</Item>
	  </FirstPersonRoadRageClipSets>
    </Item>
  </VehicleLayoutInfos>
</CVehicleMetadataMgr>